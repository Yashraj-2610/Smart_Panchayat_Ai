# Environment Configuration for Smart Panchayat AI System

# Database
DATABASE_URL=sqlite:///./smart_panchayat.db

# Security
SECRET_KEY=your-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Configuration (Optional - for future LLM integration)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
USE_LOCAL_LLM=False

# Village Configuration
VILLAGE_NAME=Alandi Gram Panchayat
DISTRICT=Pune
STATE=Maharashtra
TOTAL_WARDS=6

# Multilingual
DEFAULT_LANGUAGE=mr
SUPPORTED_LANGUAGES=en,hi,mr

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Smart Panchayat Decision Support System
PROJECT_VERSION=1.0.0

# Frontend URLs (for CORS)
FAMILY_PORTAL_URL=http://localhost:8501
SARPANCH_PORTAL_URL=http://localhost:8502
