# Database Configuration
# For local development: sqlite:///./smart_panchayat.db
# For production: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./smart_panchayat.db

# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_panchayat

# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-use-env-variable
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# AI & Multi-Agent
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
USE_LOCAL_LLM=False

# Multilingual
SUPPORTED_LANGUAGES=en,hi,mr
DEFAULT_LANGUAGE=mr

# Village Settings
VILLAGE_NAME=Alandi Gram Panchayat
DISTRICT=Pune
STATE=Maharashtra
TOTAL_WARDS=6

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# CORS
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8502,http://localhost:8000

# Deployment
ENVIRONMENT=development
DEBUG=True